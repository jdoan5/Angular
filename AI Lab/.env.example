# Vertex AI express-mode API key (Google Cloud console → Agent Platform →
# Authenticate → API Key → Set up).
# Copy this file to .env.local and paste your key. .env.local is git-ignored.
GEMINI_API_KEY=

# Key type. Leave as-is for a key created in the CLOUD CONSOLE (Vertex express
# mode, the default here). ONLY set GEMINI_VERTEX=0 if you instead created the
# key at aistudio.google.com (AI Studio) — the two key types are not
# interchangeable and a mismatch fails with 401.
# GEMINI_VERTEX=1

# Optional model override:
# GEMINI_MODEL=gemini-3.5-flash
