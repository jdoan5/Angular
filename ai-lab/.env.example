# Gemini API key. Easiest (no billing, no cloud project): create one at
# https://aistudio.google.com/apikey and keep GEMINI_VERTEX=0.
# Copy this file to .env.local and paste your key. .env.local is git-ignored.
GEMINI_API_KEY=

# Key backend. 0 = AI Studio key (the default recommendation).
# Set to 1 ONLY for a Vertex AI express-mode key minted in the Google Cloud
# console — the two key types are not interchangeable and a mismatch fails
# with 401/403. NOTE: a Vertex key stops working if the GCP project loses its
# billing link (BILLING_DISABLED) — learned the hard way.
GEMINI_VERTEX=0

# Optional model override:
# GEMINI_MODEL=gemini-3.5-flash
